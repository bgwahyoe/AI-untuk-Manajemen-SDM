    {
      "parameters": {
        "jsCode": "// 1. Ambil data dari Webhook\nconst webhookData = $('Webhook').first().json.query;\nconst daysRequested = parseInt(webhookData.days);\n\n// 2. Ambil data dari Google Sheets\nconst currentData = $input.first().json;\nconst currentBalance = parseInt(currentData.Saldo_Cuti);\n\n// 3. Validasi data\nif (!Number.isFinite(daysRequested) || daysRequested <= 0) {\n  throw new Error('Durasi cuti tidak valid.');\n}\n\nif (!Number.isFinite(currentBalance) || currentBalance < daysRequested) {\n  throw new Error('Saldo cuti tidak mencukupi.');\n}\n\n// 4. Hitung saldo baru\nconst newBalance = currentBalance - daysRequested;\n\n// 5. Return data untuk update\nreturn [{\n  json: {\n    ...currentData,\n    newBalance: newBalance\n  }\n}];"
      },
