    {
      "parameters": {
        "jsCode": "const employeeData = $input.first().json;\nconst formData = $('On form submission').first().json;\n\n// 1. Proses tanggal menggunakan Luxon\nconst start = DateTime.fromISO(formData[\"Tanggal Mulai\"]);\nconst end = DateTime.fromISO(formData[\"Tanggal Selesai\"]);\n\n// 2. Validasi tanggal\nif (!start.isValid || !end.isValid) {\n  throw new Error(\"Format tanggal pengajuan tidak valid.\");\n}\n\nif (end < start) {\n  throw new Error(\"Tanggal selesai tidak boleh sebelum tanggal mulai.\");\n}\n\n// 3. Hitung durasi cuti (inklusif)\nconst durationInDays = end.diff(start, 'days').days + 1;\n\n// 4. Validasi saldo cuti\nconst currentBalance = Number(employeeData[\"Saldo_Cuti\"]);\n\nif (!Number.isFinite(currentBalance)) {\n  throw new Error(\"Saldo cuti karyawan tidak valid.\");\n}\n\nconst hasEnoughBalance = currentBalance >= durationInDays;\n\n// 5. Generate ID pengajuan\nconst uniqueId = 'REQ-' + Date.now();\n\n// 6. Gabungkan seluruh data\nreturn [\n  {\n    json: {\n      ...employeeData,\n      ...formData,\n      durationRequested: durationInDays,\n      isApprovedSystem: hasEnoughBalance,\n      message: hasEnoughBalance\n        ? \"Saldo Cukup\"\n        : \"Saldo Tidak Cukup\",\n      remainingBalance: currentBalance - durationInDays,\n      requestId: uniqueId\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
